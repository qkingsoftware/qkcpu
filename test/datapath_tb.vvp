    %vpi_call/w 3 109 "$display", "DATAPATH fourth TEST PASSED!" {0 0 0};
    %jmp T_3.9;
T_3.8 ;
    %vpi_call/w 3 111 "$display", "DATAPATH fourth TEST FAILED!" {0 0 0};
T_3.9 ;
    %vpi_call/w 3 114 "$finish" {0 0 0};
    %end;
